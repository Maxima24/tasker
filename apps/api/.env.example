DATABASE_URL="postgresql://tasker:tasker@localhost:5433/tasker?schema=public"
REDIS_URL="redis://localhost:6380"
JWT_SECRET="dev-tasker-jwt-secret-change-me"
VAULT_KEY_SECRET="dev-tasker-vault-key-change-me"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
TELEGRAM_BOT_USERNAME="your_bot"
INTERNAL_API_SECRET="dev-internal-secret-change-me"

# --- Cloudflare R2: onboarding and task tutorial videos ---------------------
# All five come from the Cloudflare dashboard. Leave them blank and videos are
# stored on this server instead; the Videos page says which mode is active.
#
# R2 > Overview: "Account ID" in the right-hand panel.
R2_ACCOUNT_ID=
# R2 > Manage R2 API tokens > Create API token, permission "Object Read & Write",
# scoped to the bucket below. Copy both values when shown; the secret is shown once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The bucket name exactly as created, e.g. tasker-videos
R2_BUCKET=
# Bucket > Settings > Public access: the public r2.dev address, or a custom
# domain connected to the bucket (better for real use; r2.dev is rate-limited).
# e.g. https://pub-1234567890abcdef.r2.dev
# Only the API reads from it. Taskers never see this address.
R2_PUBLIC_URL=

# --- Push notifications for admins and sub-admins ----------------------------
# A key pair identifying this server to browser push services. Generate a new
# pair with: npx web-push generate-vapid-keys   (changing it signs every device out
# of notifications; they switch it back on from the console header).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can use about this server.
VAPID_SUBJECT=mailto:admin@tasker.dev

# --- First admin on a fresh server ------------------------------------------
# Created at startup only while no admin exists. They must choose a new password
# on first sign-in. Not needed locally: the demo seed creates admin@tasker.dev.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional: a separate PRIVATE R2 bucket for proof screenshots. Without it they
# share R2_BUCKET under random keys, read only through the API.
R2_PROOF_BUCKET=
